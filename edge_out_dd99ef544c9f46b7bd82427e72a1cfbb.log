						<span class="shadowing-tag" id="comm-card-topic-tag">CHỦ ĐỀ: TỰ GIỚI THIỆU</span>
						<span id="comm-card-sentence-idx" style="font-size:13px;font-weight:700;color:var(--text-muted);">Câu 1/6</span>
					</div>
					<div class="shadowing-sentence-box">
						<div style="font-size:13px;font-weight:700;color:var(--secondary);margin-bottom:4px;" id="comm-speaker-tag">Người nói: 성찬</div>
						<div class="interactive-korean-line" id="comm-interactive-korean">
							<!-- Word spans with tooltips are dynamically injected here -->
						</div>
						<div class="romaja-line" id="comm-romaja-text">Romaja</div>
						<div class="vi-line" id="comm-vietnamese-text">Dịch nghĩa tiếng Việt</div>
					</div>
