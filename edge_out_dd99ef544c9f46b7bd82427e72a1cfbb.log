						</div>
						<div style="display:flex;align-items:center;gap:8px;">
							<span id="exam-player-timer" style="font-size:13px;font-weight:700;color:var(--warning);">⏱️ 00:00</span>
						</div>
					</div>
					<div class="question-instruction" id="exam-q-instruction">Hướng dẫn câu hỏi</div>
