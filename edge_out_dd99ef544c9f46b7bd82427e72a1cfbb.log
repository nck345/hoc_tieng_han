						</div>
					</div>
					<div class="question-passage" id="exam-q-passage">Nội dung câu hỏi / Ngữ cảnh</div>
					<div class="options-list" id="exam-q-options-list"></div>
					<div style="display:flex;justify-content:flex-end;">
						<button class="mode-btn" id="btn-exam-submit-ans" style="padding:12px 28px;font-size:15px;">Nộp câu trả lời &amp; Xem giải thích</button>
					</div>
					<!-- SOLUTION PANEL (HIỆN NGAY SAU KHI LÀM XONG CÂU ĐÓ) -->
					<div class="solution-panel" id="exam-solution-panel">
						<div class="bird-feedback-card" id="exam-bird-feedback">
							<img src="assets/birds/bird-happy.svg" class="bird-feedback-img" id="exam-bird-img" alt="Ảnh chim">
							<div class="bird-feedback-text">
								<h4 id="exam-bird-title">Chính xác! Thưởng chú chim vui vẻ</h4>
								<p id="exam-bird-desc">Bạn đã trả lời đúng câu hỏi này.</p>
							</div>
						</div>
						<div class="analysis-section">
							<div class="analysis-title">
								<span>💡</span>
								<span>Đáp án &amp; Giải thích chi tiết:</span>
								<span id="exam-answer-type-note" style="font-size:11px;font-weight:700;color:var(--warning);margin-left:auto;"></span>
							</div>
							<div class="analysis-content" id="exam-explanation-text">Lời giải thích chi tiết</div>
						</div>
						<!-- TRANSCRIPT (FOR LISTENING) -->
						<div class="analysis-section" id="exam-transcript-section" style="display:none;">
							<div class="analysis-title">
								<span>📜</span>
								<span>Phụ đề &amp; Kịch bản nghe (Transcript) • Bấm vào câu để nghe riêng:</span>
							</div>
							<div class="transcript-box" id="exam-transcript-box"></div>
						</div>
						<!-- GRAMMAR BREAKDOWN -->
						<div class="analysis-section" id="exam-grammar-section">
							<div class="analysis-title">
								<span>📘</span>
								<span>Ngữ pháp trọng tâm xuất hiện trong câu:</span>
							</div>
							<div id="exam-grammar-list" style="display:flex;flex-direction:column;gap:8px;"></div>
						</div>
						<!-- VOCABULARY BREAKDOWN (DANH/ĐỘNG/TÍNH/TRẠNG TỪ) -->
						<div class="analysis-section" id="exam-vocab-section">
