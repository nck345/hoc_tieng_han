					<div style="display:flex;align-items:center;gap:8px;">
						<span class="quiz-badge">Kiểm tra 5 từ</span>
						<span id="quiz-progress-text" style="font-size:13px;font-weight:700;color:var(--text-muted);">Câu 1/5</span>
					</div>
					<span style="font-size:12px;color:var(--text-secondary);">Gõ &amp; Phát âm</span>
				</div>
				<div class="quiz-q-box">
					<div class="quiz-vi-word" id="quiz-vi-word">Con dâu</div>
					<div class="quiz-vi-sub" id="quiz-pos-hint">[Danh từ]</div>
				</div>
				<div>
					<label for="quiz-korean-input" style="font-size:12px;font-weight:700;color:var(--text-secondary);display:block;margin-bottom:6px;">Nhập từ tiếng Hàn tương ứng:</label>
					<input type="text" class="quiz-input-field" id="quiz-korean-input" placeholder="Gõ tiếng Hàn vào đây..." autocomplete="off">
				</div>
				<div class="quiz-recording-bar">
					<button class="btn-mic" id="btn-quiz-mic" title="Bắt đầu / Dừng ghi âm phát âm">🎤</button>
					<span class="rec-status-text" id="quiz-rec-status">Bấm nút mic để phát âm</span>
					<div class="quiz-playback-controls" id="quiz-playback-area">
						<button class="btn-quiz-audio" id="btn-play-user-voice">▶ Nghe lại</button>
					</div>
				</div>
				<div class="quiz-feedback-box" id="quiz-feedback-box"></div>
				<button class="mode-btn" id="btn-quiz-check" style="width:100%;padding:12px;font-size:15px;">Kiểm tra đáp án</button>
				<button class="mode-btn" id="btn-quiz-next-q" style="width:100%;padding:12px;font-size:15px;display:none;background:var(--accent);">Câu tiếp theo →</button>
			</div>
			<div id="quiz-summary-card" class="celebrate-card" style="display:none;">
