							<span>🐢</span> <span>Nghe chậm (0.75x)</span>
						</button>
						<button class="btn-mic-large" id="btn-comm-mic" title="Bấm rồi nói để luyện phát âm">🎤</button>
						<div class="quiz-playback-controls" id="comm-user-audio-wrap" style="display:none;">
							<button class="btn-quiz-audio" id="btn-comm-play-user">▶ Nghe lại giọng mình</button>
						</div>
					</div>
					<div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
						<span id="comm-rec-status" style="font-size:13px;color:var(--text-secondary);font-weight:600;">Bấm nút mic tròn đỏ rồi phát âm câu trên</span>
						<div id="comm-accuracy-badge-wrap" style="display:none;">
							<div class="accuracy-badge high" id="comm-accuracy-badge">
								<span>🎯</span> <span id="comm-accuracy-val">Độ chính xác: 95%</span>
							</div>
						</div>
					</div>
					<div style="display:flex;justify-content:space-between;margin-top:10px;">
						<button class="btn-back" id="btn-comm-prev">← Câu trước</button>
						<button class="mode-btn" id="btn-comm-next">Câu tiếp theo →</button>
					</div>
				</div>
