				<h3>Hoàn thành bài kiểm tra nhỏ!</h3>
				<p id="quiz-summary-score" style="font-size:18px;font-weight:700;color:var(--accent);">Kết quả: 5/5 từ chính xác</p>
				<button class="mode-btn" id="btn-finish-quiz" style="padding:12px 28px;margin-top:10px;">Tiếp tục bài học →</button>
			</div>
		</div>
	</div>

	<!-- MODAL HOÀN THÀNH UNIT -->
	<div class="modal-overlay" id="complete-modal">
		<div class="modal-card celebrate-card">
			<div class="celebrate-icon">🎉</div>
			<h3 style="font-size:24px;">Chúc mừng bạn đã hoàn thành Unit!</h3>
			<p id="complete-unit-title" style="font-size:16px;color:#93c5fd;font-weight:700;">DAY 1: 가족 (Gia đình)</p>
			<p style="color:var(--text-secondary);font-size:14px;max-width:380px;">Bạn đã học xong toàn bộ từ vựng và xuất sắc vượt qua các bài kiểm tra của bài học này.</p>
			<div id="complete-countdown" style="font-size:13px;color:var(--text-muted);font-weight:600;margin-top:6px;">Tự động quay lại danh sách sau 3 giây...</div>
			<button class="btn-back" id="btn-complete-back" style="margin-top:8px;">Về danh sách bài học ngay</button>
		</div>
	</div>

	<!-- MODAL THƯỞNG ẢNH CHIM ĐẶC BIỆT KHI HOÀN THÀNH GÓI 10 CÂU -->
	<div class="modal-overlay" id="bird-reward-modal">
		<div class="modal-card celebrate-card">
			<div style="width:120px;height:120px;" id="modal-reward-bird-icon-wrap">
